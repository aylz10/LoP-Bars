      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : LOP-Win64-Shipping.exe
  Version: 
  Date   : 2024-01-21
  Author : Etzikun

  This script retrieves the player object base address.
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscanmodule(Pino_C,LOP-Win64-Shipping.exe,48 8B 01 FF 90 60 01 00 00 49 3B C4 0F) // should be unique
alloc(newmem,$1000,Pino_C)
registersymbol(Pino_C)
registersymbol(pPino_C)
label(code)
label(return)
label(pPino_C)

newmem:
  cmp [pPino_C],rcx
  je code
  mov [pPino_C],rcx

code:
  mov rax,[rcx]
  call qword ptr [rax+00000160]
  jmp return

pPino_C:
dq 0

Pino_C:
  jmp newmem
  nop 4
return:

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
Pino_C:
  db 48 8B 01 FF 90 60 01 00 00

unregistersymbol(Pino_C)
unregistersymbol(pPino_C)
dealloc(newmem)

