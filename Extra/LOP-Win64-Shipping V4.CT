                        </CheatEntry>
                        <CheatEntry>
                          <ID>9138</ID>
                          <Description>"GetItemCodes (Weapon Swap Prior to Activate)"</Description>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{$lua}
[ENABLE]

if syntaxcheck then return end

local createMemoryRecord = createMemoryRecord or getAddressList().createMemoryRecord

-- Function to get or create the "ItemCodes" header
local function getItemCodesHeader()
    local itemCodesHeader = getAddressList().getMemoryRecordByDescription('ItemCodes')
    if itemCodesHeader == nil then
        itemCodesHeader = createMemoryRecord()
        itemCodesHeader.Description = "ItemCodes"
        itemCodesHeader.IsGroupHeader = true
        itemCodesHeader.Options = "[moHideChildren,moAllowManualCollapseAndExpand]"
    end
    return itemCodesHeader
end

-- Main script
local baseAddressHexValue = "[ContentInfo]"
local finalAddress = getAddress(baseAddressHexValue)

if finalAddress ~= nil then
    local arraySizeAddress = finalAddress + 0xF8
    local arraySize = readInteger(arraySizeAddress)
    local baseArrayAddress = readQword(finalAddress + 0xF0)
    if baseArrayAddress ~= nil then
        local tableItems = {}
        for i = 1, arraySize do
            local itemAddress = baseArrayAddress + (i - 1) * 0x1B8 + 0x28
            local itemValue = readQword(itemAddress)
            local namePointerAddress = itemAddress + 0x8
            local nameAddress = readQword(namePointerAddress)

            local name = ""
            local char = readBytes(nameAddress, 2)
            while char ~= nil and char ~= 0x00 do
                name = name .. string.char(char % 256)
                nameAddress = nameAddress + 2
                char = readBytes(nameAddress, 2)
            end

            local itemType, itemName = string.match(name, "_([^_]+)_(.*)")
            if itemType ~= nil and itemName ~= nil then
                if string.find(itemName, "Ergo") then
                    itemType = "Ergo"
                end
                if string.find(itemName, "key") then
                    itemType = "key"
                end
                print("Item", i, ":", "Sub-Category:", itemType, "Name:", itemName)
            else
                print("Failed to extract item sub-category and name for Item", i)
            end

            tableItems[i] = {Value = itemValue, ItemType = itemType, Name = itemName, Address = itemAddress}
        end

        local itemCodesHeader = getItemCodesHeader()

        for _, v in ipairs(tableItems) do
            if v.ItemType ~= nil and v.Name ~= nil then
                local groupHeader = getAddressList().getMemoryRecordByDescription(v.ItemType)
                if groupHeader == nil then
                    groupHeader = createMemoryRecord()
                    groupHeader.Description = v.ItemType
                    groupHeader.IsGroupHeader = true
                    groupHeader.Options = "[moHideChildren,moAllowManualCollapseAndExpand]"
                    groupHeader.appendToEntry(itemCodesHeader)
                end

                local entry = createMemoryRecord()
                entry.Description = v.Name
                entry.Address = v.Address
                entry.Type = vtQword

                entry.appendToEntry(groupHeader)
            end
        end

    else
        print("Failed to dereference pointer at array address.")
    end
else
    print("Failed to dereference pointer at base address: " .. baseAddressHexValue)
end

[DISABLE]

</AssemblerScript>
                        </CheatEntry>
                      </CheatEntries>
                    </CheatEntry>
                  </CheatEntries>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
