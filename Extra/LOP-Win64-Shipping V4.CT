aobscanmodule(dialog2,$process,4C 8B ? 45 33 ? 48 8B ? 48 8B ? 41 FF ? ? ? ? ? EB) // should be unique
alloc(newmem,$200,dialog2)
registersymbol(dialog2 time2)
label(code return time2 cheat)

newmem:
  test rbx,rbx
  jz return
  cmp byte ptr[rbx+2A8],01
  jne code
  cmp byte ptr[rbx+278],00
  je code
  mov [time2],rbx

cheat:
  push r15
  mov r15,[rbx+420]
  mov [rbx+424],r15
  pop r15

code:
  mov r9,[rbx]
  xor r8d,r8d
  jmp return

time2:
  dq 0

dialog2:
  jmp newmem
  nop
return:


