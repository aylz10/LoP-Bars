alloc(newmem1,$100,Pino_C)
alloc(newmem2,$100,GetCT)
label(code1 code2 return1 return2 pPino_C ContentInfo)

newmem1:
  test rcx,rcx
  jz return1
  mov [pPino_C],rcx

code1:
  mov rax,[rcx]
  call qword ptr [rax+00000160]
  jmp return1

pPino_C:
dq 0

Pino_C:
  jmp newmem1
  nop 4

return1:

// second script to get the content info database

newmem2:
  mov [ContentInfo],rbx

code2:
  mov eax,[rbx+000002E8]
  jmp return2

ContentInfo:
dq 0

GetCT:
  jmp newmem2
  nop

return2:
registersymbol(Pino_C pPino_C GetCT ContentInfo)

[DISABLE]

Pino_C:
  db 48 8B 01 FF 90 60 01 00 00

GetCT:
  db 8B 83 E8 02 00 00

unregistersymbol(*)
dealloc(*)

