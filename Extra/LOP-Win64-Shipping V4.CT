              <ID>1078</ID>
              <Description>"Perfect Guard"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : LOP-Win64-Shipping.exe
  Version: 
  Date   : 2024-01-25
  Author : Etzikun

  This script multiplies the perfect guard window by a user defined amount.
}

[ENABLE]

aobscanmodule(parry,$process,F3 41 ? ? ? ? ? ? ? C3 F3 0F ? ? ? ? ? ? C3 CC CC CC CC CC CC CC CC CC CC CC CC CC CC CC ? ? ? ? ? ?) // should be unique
alloc(newmem,$1000,parry)
registersymbol(parry fParryMult fParry)
label(fParryMult fParry code return)

newmem:

code:
  movss xmm0,[r8+0000023C]
  mulss xmm0,dword ptr[fParryMult]
  movss [fParry],xmm0
  jmp return

fParryMult:
dd (float)1.0

fParry:
dd 0

parry:
  jmp newmem
  nop 4
return:

[DISABLE]

parry:
  db F3 41 0F 10 80 3C 02 00 00

unregistersymbol(parry fParryMult fParry)
dealloc(newmem)

