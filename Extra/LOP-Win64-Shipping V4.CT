aobscanmodule(slow,$process,F3 0F ? ? ? ? ? ? EB ? F3 0F ? ? ? ? ? ? 48 8B ? ? 4C 8B ? F3 0F ? ? 44 8B) // should be unique
alloc(newmem,$1000,slow)
registersymbol(slow bSlowTarget bSlowAll bSpeedPino fSlowMult1 fSlowMult2 fSpeedMult)
label(code return next pino bSlowTarget bSlowAll bSpeedPino fSlowMult1 fSlowMult2 fSpeedMult)

newmem:
    test rbx,rbx
    jz return
    push r12
    mov r12,[pPino_C]
    cmp byte ptr[bSlowTarget],01
    jne next
    cmp rbx,[r12+CC8]
    jne next
    movss xmm1,[fSlowMult1]
    pop r12
    jmp return

next:
    cmp rbx,r12
    je pino
    cmp byte ptr[bSlowAll],1
    jne code
    cmp byte ptr[rbx+5F],1
    jne code
    movss xmm1,[fSlowMult2]
    pop r12
    jmp return

pino:
    cmp byte ptr[bSpeedPino],1
    jne code
    movss xmm1,[fSpeedMult]
    pop r12
    jmp return

code:
    pop r12
    movss xmm1,[rbx+00000098]
    jmp return

bSlowTarget:
    db 0

bSlowAll:
    db 0

bSpeedPino:
    db 0

fSlowMult1:
    dd (float)1

fSlowMult2:
    dd (float)1

fSpeedMult:
    dd (float)1

slow:
    jmp newmem
    nop 3

return:

[DISABLE]

slow:
  db F3 0F 10 8B 98 00 00 00

