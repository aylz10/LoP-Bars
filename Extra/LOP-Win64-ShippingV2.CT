              <AssemblerScript>{ Game   : LOP-Win64-Shipping.exe
  Version: 
  Date   : 2024-01-25
  Author : Etzikun

  This script multiplies the perfect guard window by a user defined amount.
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscanmodule(parry,LOP-Win64-Shipping.exe,F3 41 ? ? ? ? ? ? ? C3 F3 0F ? ? ? ? ? ? C3 CC CC CC CC CC CC CC CC CC CC CC CC CC CC CC ? ? ? ? ? ?) // should be unique
alloc(newmem,$1000,parry)
registersymbol(parry)
registersymbol(fParryMult)
registersymbol(fParry)
label(fParryMult)
label(fParry)
label(code)
label(return)

newmem:

code:
  movss xmm0,[r8+0000023C]
  mulss xmm0,dword ptr[fParryMult]
  movss [fParry],xmm0
  jmp return

fParryMult:
dd (float)1.0

fParry:
dd 0

parry:
  jmp newmem
  nop 4
return:

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
parry:
  db F3 41 0F 10 80 3C 02 00 00

unregistersymbol(parry)
unregistersymbol(fParryMult)
unregistersymbol(fParry)
dealloc(newmem)

