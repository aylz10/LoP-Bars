            <CheatEntry>
              <ID>1123</ID>
              <Description>"Speed Master"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : LOP-Win64-Shipping.exe
  Version: 
  Date   : 2024-01-26
  Author : Etzikun

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

// 2E 48 85 DB 74 0A F3 0F 10 8B 98 00 00 00

aobscanmodule(slow,LOP-Win64-Shipping.exe,F3 0F ? ? ? ? ? ? EB ? F3 0F ? ? ? ? ? ? 48 8B ? ? 4C 8B ? F3 0F ? ? 44 8B) // should be unique
alloc(newmem,$1000,slow)
registersymbol(slow)
registersymbol(bSlowTarget)
registersymbol(bSlowAll)
registersymbol(bSpeedPino)
registersymbol(fSlowMult1)
registersymbol(fSlowMult2)
registersymbol(fSpeedMult)
label(code)
label(return)
label(next)
label(pino)
label(bSlowTarget)
label(bSlowAll)
label(bSpeedPino)
label(fSlowMult1)
label(fSlowMult2)
label(fSpeedMult)

newmem:
    push r12
    mov r12,[pPino_C]
    cmp byte ptr[bSlowTarget],01
    jne next
    cmp rbx,[r12+CC8]
    jne next
    movss xmm1,[fSlowMult1]
    pop r12
    jmp return

next:
    cmp rbx,r12
    je pino
    cmp byte ptr[bSlowAll],1
    jne code
    cmp byte ptr[rbx+5F],1
    jne code
    movss xmm1,[fSlowMult2]
    pop r12
    jmp return

pino:
    cmp byte ptr[bSpeedPino],1
    jne code
    movss xmm1,[fSpeedMult]
    pop r12
    jmp return

code:
    pop r12
    movss xmm1,[rbx+00000098]
    jmp return

bSlowTarget:
    db 0

bSlowAll:
    db 0

bSpeedPino:
    db 0

fSlowMult1:
    dd (float)1

fSlowMult2:
    dd (float)1

fSpeedMult:
    dd (float)1

slow:
    jmp newmem
    nop 3

return:


[DISABLE]
//code from here till the end of the code will be used to disable the cheat
slow:
  db F3 0F 10 8B 98 00 00 00

unregistersymbol(slow)
unregistersymbol(bSlowTarget)
unregistersymbol(bSlowAll)
unregistersymbol(fSlowMult1)
unregistersymbol(fSlowMult2)
unregistersymbol(fSpeedMult)
dealloc(newmem)

