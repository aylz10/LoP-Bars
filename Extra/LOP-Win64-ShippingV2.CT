              <Description>"Stat Master"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Game   : LOP-Win64-Shipping.exe
  Version: 
  Date   : 2024-01-22
  Author : Etzikun

  This script moves large value into updated value depending on what byte is toggled.
  Get Player Instance script needs to return player pointer for this script to work.
  - To add: Enemy knockback toggle
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscanmodule(health,LOP-Win64-Shipping.exe,89 47 ? 48 8B ? 48 8B ? FF 50 ? 85 C0 7F ? 80 7F 08 ? 74 ? C7 47 0C ? ? ? ? EB ? 48 8B ? 48 8B ? FF 50 ? 48 8B ? 8B D8 E8 ? ? ? ? 3B C3 7D ? 48 8B ? E8 ? ? ? ? 89 47 ? 41 80 FF) // should be unique
// if AOBscan fails, try deleting some bytes from the end
alloc(newmem,$1000,health)
registersymbol(health bInfHealth bInfStam bInfLegion bInfFable bOHK bStun)
label(code return enable1 enable2 enable3 enable4 stun bInfHealth bInfStam bInfLegion bInfFable bOHK bStun cheat enemy)

newmem:
  push r14
  mov r14,[pPino_C]                 //load address of player actor
  cmp [r14+848],rbp                 //cmp rbp to player stat component
  jne enemy
  cmp byte ptr[rdi+08],01           //cmp health stat ID
  je enable1
  cmp byte ptr[rdi+08],02           //cmp stam stat ID
  je enable2
  cmp byte ptr[rdi+08],05           //cmp legion stat ID
  je enable3
  cmp byte ptr[rdi+08],03           //cmp fable stat ID
  jne code                          //all else jmp to original code

enable1:
  cmp byte ptr[bInfHealth],01       //check if cheat activated on table
  je cheat
  jmp code
enable2:
  cmp byte ptr[bInfStam],01
  je cheat
  jmp code
enable3:
  cmp byte ptr[bInfLegion],01
  je cheat
  jmp code
enable4:
  cmp byte ptr[bInfFable],01
  je cheat
  jmp code

enemy:
  cmp [r14+CC8],rbx                 //cmp to focused enemy offset
  jne stun
  cmp byte ptr[rdi+08],01           //cmp to enemy health stat ID
  jne stun
  cmp byte ptr[bOHK],00             //cmp one hit kill bool
  je stun
  sub rax,rsi                       //subtract last stat from updated stat

stun:
  cmp byte ptr[rdi+08],30           //cmp to enemy stagger stat ID
  jne code
  cmp byte ptr[bStun],00            //cmp instant stagger bool
  je code
  sub rax,rsi
  jmp code

cheat:
  mov rax,(int)999999               //mov big number to updated stat

code:
  pop r14
  mov [rdi+0C],eax                  //original code, update stat pointer
  mov rcx,rdi
  jmp return

  bInfHealth:
    db 01                           //ON by default
  bInfStam:
    db 01                           //ON by default
  bInfLegion:
    db 01                           //ON by default
  bInfFable:
    db 01                           //ON by default
  bOHK:
    db 00                           //OFF by default
  bStun:
    db 00                           //OFF by default

health:
  jmp newmem
  nop

return:

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
health:
  db 89 47 0C 48 8B CF

unregistersymbol(health bInfHealth bInfStam bInfLegion bInfFable bOHK bStun)
dealloc(newmem)

