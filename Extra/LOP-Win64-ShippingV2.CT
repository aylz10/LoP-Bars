              <AssemblerScript>{ Game   : LOP-Win64-Shipping.exe
  Version: 
  Date   : 2024-01-24
  Author : Etzikun

  This script does blah blah blah so, all we ever do is go ja ja ja
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

aobscanmodule(InfItem,LOP-Win64-Shipping.exe,89 51 ? FF 90 ? ? ? ? 48 8B) // should be unique
alloc(newmem,$1000,InfItem)
registersymbol(InfItem)
registersymbol(bAllItems)
label(code)
label(any)
label(return)
label(bAllItems)

newmem:
  cmp [bAllItems],1
  je any
  cmp [rcx+40],1                   //quest items might not get removed
  je code                          //or use item highlighter to set a qty to 2+

any:
  mov edx,[rcx+40]                 //current qty into updated qty

code:
  mov [rcx+40],edx                 //original code
  call qword ptr [rax+000002A0]
  jmp return

bAllItems:
db 0

InfItem:
  jmp newmem
  nop 4
return:


[DISABLE]
//code from here till the end of the code will be used to disable the cheat
InfItem:
  db 89 51 40 FF 90 A0 02 00 00

unregistersymbol(InfItem)
unregistersymbol(bAllItems)
dealloc(newmem)

